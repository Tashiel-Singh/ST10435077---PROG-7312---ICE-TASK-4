<Window x:Class="EmergencyDepartmentSystem.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Emergency Department Management System - FIFO Queue &amp; LIFO Action History"
        Height="850" Width="1380"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0A0F1D"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Dark Card Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#151E32"/>
            <Setter Property="BorderBrush" Value="#2A3854"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- Metric Card Title -->
        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Metric Card Value -->
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>

        <!-- Metric Card Subtitle -->
        <Style x:Key="MetricSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Modern Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Input TextBox -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#38BDF8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#06B6D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DataGrid Style -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#2A3854"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#111827"/>
            <Setter Property="AlternatingRowBackground" Value="#162238"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1E293B"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0E7490"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- KPI Metrics -->
            <RowDefinition Height="Auto"/> <!-- Flash Message Banner -->
            <RowDefinition Height="*"/>    <!-- Main Split Columns -->
            <RowDefinition Height="Auto"/> <!-- Footer Status -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER SECTION -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#06B6D4" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                            <TextBlock Text="HOSPITAL ED" FontWeight="Bold" FontSize="11" Foreground="#083344"/>
                        </Border>
                        <TextBlock Text="Emergency Department Management System" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>
                    <TextBlock Text="PROG7312 Advanced Programming | ICE Task 4 | Data Structures: Queue (FIFO) &amp; Stack (LIFO) | Tashiel Singh (ST10435077)"
                               FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockTextBlock" Text="08:00:00" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Seed Scenario Data" Click="OnSeedDataClicked" Style="{StaticResource ActionButtonStyle}" Background="#1E293B" Foreground="#94A3B8" BorderThickness="1" BorderBrush="#334155" Margin="0,0,8,0"/>
                    <Button Content="Reset All" Click="OnResetAllClicked" Style="{StaticResource ActionButtonStyle}" Background="#3F1515" Foreground="#F87171" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. KPI METRICS CARDS -->
        <Grid Grid.Row="1" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Metric 1: Waiting Queue -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" BorderBrush="#0891B2">
                <StackPanel>
                    <TextBlock Text="PATIENTS WAITING (FIFO)" Style="{StaticResource MetricTitleStyle}" Foreground="#06B6D4"/>
                    <TextBlock x:Name="WaitingCountText" Text="4" Style="{StaticResource MetricValueStyle}" Foreground="#22D3EE"/>
                    <TextBlock Text="Ordered by Arrival Time" Style="{StaticResource MetricSubtitleStyle}"/>
                </StackPanel>
            </Border>

            <!-- Metric 2: Next in Line -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" BorderBrush="#059669">
                <StackPanel>
                    <TextBlock Text="NEXT PATIENT (QUEUE HEAD)" Style="{StaticResource MetricTitleStyle}" Foreground="#10B981"/>
                    <TextBlock x:Name="NextPatientText" Text="#1001 John" Style="{StaticResource MetricValueStyle}" FontSize="16" Foreground="#34D399"/>
                    <TextBlock x:Name="NextPatientDetailText" Text="Chest pain (08:01)" Style="{StaticResource MetricSubtitleStyle}"/>
                </StackPanel>
            </Border>

            <!-- Metric 3: Attended -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="ATTENDED TODAY" Style="{StaticResource MetricTitleStyle}"/>
                    <TextBlock x:Name="AttendedCountText" Text="0" Style="{StaticResource MetricValueStyle}"/>
                    <TextBlock Text="Called to consultation" Style="{StaticResource MetricSubtitleStyle}"/>
                </StackPanel>
            </Border>

            <!-- Metric 4: Actions in Stack -->
            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Margin="0,0,10,0" BorderBrush="#9333EA">
                <StackPanel>
                    <TextBlock Text="ACTIONS RECORDED (LIFO)" Style="{StaticResource MetricTitleStyle}" Foreground="#A855F7"/>
                    <TextBlock x:Name="ActionsCountText" Text="4" Style="{StaticResource MetricValueStyle}" Foreground="#C084FC"/>
                    <TextBlock Text="History Stack Depth" Style="{StaticResource MetricSubtitleStyle}"/>
                </StackPanel>
            </Border>

            <!-- Metric 5: Top of Stack Action -->
            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" BorderBrush="#D97706">
                <StackPanel>
                    <TextBlock Text="LATEST ACTION (STACK TOP)" Style="{StaticResource MetricTitleStyle}" Foreground="#F59E0B"/>
                    <TextBlock x:Name="LatestActionTypeText" Text="Doctor's notes added" Style="{StaticResource MetricValueStyle}" FontSize="15" Foreground="#FBBF24"/>
                    <TextBlock x:Name="LatestActionPatientText" Text="Patient #1002 (Sarah)" Style="{StaticResource MetricSubtitleStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. FLASH NOTIFICATION BANNER -->
        <Border x:Name="NotificationBanner" Grid.Row="2" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Margin="20,0,20,10" Padding="14,8" Visibility="Collapsed">
            <Grid>
                <TextBlock x:Name="NotificationText" Text="Patient called successfully!" Foreground="#A7F3D0" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                <Button Content="x" Click="OnDismissBannerClicked" HorizontalAlignment="Right" Background="Transparent" Foreground="#6EE7B7" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- 4. MAIN SPLIT VIEW (2 EQUAL COLUMNS) -->
        <Grid Grid.Row="3" Margin="20,0,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> <!-- Left: Queue -->
                <ColumnDefinition Width="16"/> <!-- Spacer -->
                <ColumnDefinition Width="*"/> <!-- Right: Stack -->
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: PATIENT WAITING QUEUE (FIFO) -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Call Button -->
                        <RowDefinition Height="Auto"/> <!-- Register Form Expander -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- FIFO Explanation -->
                    </Grid.RowDefinitions>

                    <!-- Section Header & Call Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Patient Waiting List" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Requirement 2 &amp; 3: First-In, First-Out (FIFO) Processing" FontSize="11" Foreground="#06B6D4"/>
                        </StackPanel>
                        <Button Content=">> CALL NEXT PATIENT" Click="OnCallNextPatientClicked" Style="{StaticResource ActionButtonStyle}"
                                Background="#059669" Foreground="#FFFFFF" HorizontalAlignment="Right" Padding="18,0"/>
                    </Grid>

                    <!-- Register Patient Form (Collapsible Expander) -->
                    <Expander Grid.Row="1" x:Name="RegisterExpander" Header="+ Register New Patient (Requirement 1)" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,12">
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="Patient Number *" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="RegPatientNumberBox" Style="{StaticResource ModernTextBoxStyle}" Text="1005"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                                    <TextBlock Text="Patient Name *" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="RegPatientNameBox" Style="{StaticResource ModernTextBoxStyle}" Text="Emily Watson"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="Age *" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="RegAgeBox" Style="{StaticResource ModernTextBoxStyle}" Text="29"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,8">
                                    <TextBlock Text="Reason for Visit *" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="RegReasonBox" Style="{StaticResource ModernTextBoxStyle}" Text="Acute asthma flare-up"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="Triage Priority" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="RegTriageCombo" Height="30" Background="#0F172A" Foreground="#0F172A" SelectedIndex="1">
                                        <ComboBoxItem Content="Priority 1 - Urgent"/>
                                        <ComboBoxItem Content="Priority 2 - Moderate"/>
                                        <ComboBoxItem Content="Priority 3 - Standard"/>
                                    </ComboBox>
                                </StackPanel>

                                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="Register Patient &amp; Enqueue" Click="OnRegisterSubmitClicked"
                                        Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </Expander>

                    <!-- Waiting Patients DataGrid -->
                    <DataGrid Grid.Row="2" x:Name="WaitingPatientsDataGrid" Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Line Pos" Binding="{Binding PositionLabel}" Width="80"/>
                            <DataGridTextColumn Header="Arrival" Binding="{Binding FormattedArrivalTime}" Width="70"/>
                            <DataGridTextColumn Header="Pat #" Binding="{Binding PatientNumber}" Width="65"/>
                            <DataGridTextColumn Header="Patient Name" Binding="{Binding PatientName}" Width="120"/>
                            <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="45"/>
                            <DataGridTextColumn Header="Triage" Binding="{Binding TriageCategory}" Width="110"/>
                            <DataGridTextColumn Header="Reason for Visit" Binding="{Binding ReasonForVisit}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer Note -->
                    <Border Grid.Row="3" Background="#0F172A" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <TextBlock Text="FIFO Theory: Elements are processed in exact arrival order. Enqueue at rear O(1), Dequeue at front O(1)."
                                   FontSize="10.5" Foreground="#64748B"/>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: CLINICAL ACTION HISTORY (LIFO STACK) -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Undo Button -->
                        <RowDefinition Height="Auto"/> <!-- Record Action Form Expander -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- LIFO Explanation -->
                    </Grid.RowDefinitions>

                    <!-- Section Header & Undo Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Patient Action History" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="Requirement 4, 5 &amp; 6: Last-In, First-Out (LIFO) Undo Mechanism" FontSize="11" Foreground="#A855F7"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Peek Latest" Click="OnPeekActionClicked" Style="{StaticResource ActionButtonStyle}"
                                    Background="#334155" Foreground="#CBD5E1" Margin="0,0,8,0" Padding="12,0"/>
                            <Button Content="&lt;&lt; UNDO LAST ACTION" Click="OnUndoLastActionClicked" Style="{StaticResource ActionButtonStyle}"
                                    Background="#B45309" Foreground="#FFFFFF" Padding="16,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Record Action Form (Collapsible Expander) -->
                    <Expander Grid.Row="1" x:Name="RecordExpander" Header="+ Record Patient Action (Requirement 4)" Foreground="#C084FC" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,12">
                        <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="Patient Number *" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ActPatientNumberBox" Style="{StaticResource ModernTextBoxStyle}" Text="1001"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                    <TextBlock Text="Action Type *" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ActCategoryCombo" Height="30" Background="#0F172A" Foreground="#0F172A" SelectedIndex="0">
                                        <ComboBoxItem Content="Blood pressure updated"/>
                                        <ComboBoxItem Content="Medication added"/>
                                        <ComboBoxItem Content="Allergy information updated"/>
                                        <ComboBoxItem Content="Doctor's notes added"/>
                                        <ComboBoxItem Content="Vitals &amp; Oxygen Saturation"/>
                                        <ComboBoxItem Content="IV Line Started"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,8,8">
                                    <TextBlock Text="Action Notes / Description *" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ActDescriptionBox" Style="{StaticResource ModernTextBoxStyle}" Text="Repeat BP: 124/82 mmHg normal range"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                    <TextBlock Text="Staff Name" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ActStaffBox" Style="{StaticResource ModernTextBoxStyle}" Text="Nurse Elena"/>
                                </StackPanel>

                                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="Record Action &amp; Push to Stack" Click="OnRecordActionSubmitClicked"
                                        Style="{StaticResource ActionButtonStyle}" Background="#7E22CE" Foreground="#FFFFFF" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </Expander>

                    <!-- Action History DataGrid -->
                    <DataGrid Grid.Row="2" x:Name="ActionHistoryDataGrid" Style="{StaticResource ModernDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Stack Order" Binding="{Binding StackLabel}" Width="90"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding FormattedTimestamp}" Width="70"/>
                            <DataGridTextColumn Header="Act #" Binding="{Binding ActionId}" Width="50"/>
                            <DataGridTextColumn Header="Patient" Binding="{Binding PatientDisplay}" Width="120"/>
                            <DataGridTextColumn Header="Action Category" Binding="{Binding ActionType}" Width="140"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Staff" Binding="{Binding StaffName}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer Note -->
                    <Border Grid.Row="3" Background="#0F172A" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
                        <TextBlock Text="LIFO Theory: Most recently pushed action sits at top of stack. Undo pops topmost action in O(1) time." 
                                   FontSize="10.5" Foreground="#64748B"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. FOOTER STATUS BAR -->
        <Border Grid.Row="4" Background="#090D1A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <TextBlock x:Name="StatusBarText" Text="Ready | PROG7312 Emergency Department Management System active" FontSize="11" Foreground="#64748B"/>
                <TextBlock Text="Visual Demonstration for Academic Assessment" FontSize="11" Foreground="#475569" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>